{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Dev (Ninja, Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (Ninja, Release)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "ASan + UBSan (Ninja, Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GG_SANITIZE": "ON",
        "GG_BUILD_PLUGINS": "ON",
        "GG_BUILD_EDITOR": "OFF"
      }
    },
    {
      "name": "rtsan",
      "inherits": "base",
      "displayName": "RealtimeSanitizer (Ninja, RelWithDebInfo, clang from $GG_LLVM)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "GG_USE_RTSAN": "ON",
        "GG_BUILD_PLUGINS": "ON",
        "GG_BUILD_EDITOR": "OFF",
        "CMAKE_C_COMPILER": "$env{GG_LLVM}/bin/clang",
        "CMAKE_CXX_COMPILER": "$env{GG_LLVM}/bin/clang++"
      }
    },
    {
      "name": "mac-universal",
      "inherits": "release",
      "displayName": "macOS universal (Ninja, Release, arm64 + x86_64)",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64"
      }
    },
    {
      "name": "windows-clangcl",
      "inherits": "base",
      "displayName": "Windows (Ninja, clang-cl, x64, Release; from a VS 2022 x64 developer shell)",
      "binaryDir": "${sourceDir}/build/windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "linux-gcc13",
      "inherits": "release",
      "displayName": "Linux (Ninja, Release, gcc-13)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-13",
        "CMAKE_CXX_COMPILER": "g++-13"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "rtsan",
      "configurePreset": "rtsan"
    },
    {
      "name": "mac-universal",
      "configurePreset": "mac-universal"
    },
    {
      "name": "windows-clangcl",
      "configurePreset": "windows-clangcl",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc13",
      "configurePreset": "linux-gcc13"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 8
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": {
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "rtsan",
      "inherits": "base",
      "configurePreset": "rtsan"
    },
    {
      "name": "mac-universal",
      "inherits": "base",
      "configurePreset": "mac-universal"
    },
    {
      "name": "windows-clangcl",
      "inherits": "base",
      "configurePreset": "windows-clangcl",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc13",
      "inherits": "base",
      "configurePreset": "linux-gcc13"
    }
  ]
}
