{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Dev (Ninja, Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (Ninja, Release)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "ASan + UBSan (Ninja, Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GG_SANITIZE": "ON",
        "GG_BUILD_PLUGINS": "OFF"
      }
    },
    {
      "name": "rtsan",
      "inherits": "base",
      "displayName": "RealtimeSanitizer (Ninja, RelWithDebInfo, clang from $GG_LLVM)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "GG_USE_RTSAN": "ON",
        "GG_BUILD_PLUGINS": "OFF",
        "CMAKE_C_COMPILER": "$env{GG_LLVM}/bin/clang",
        "CMAKE_CXX_COMPILER": "$env{GG_LLVM}/bin/clang++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "rtsan",
      "configurePreset": "rtsan"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": {
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "rtsan",
      "inherits": "base",
      "configurePreset": "rtsan"
    }
  ]
}
