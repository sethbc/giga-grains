#
# Writes the C++ source of gg::ui::noticeTexts() (gg/ui/Notices.h) from the license set. Run at
# build time by gg_add_notices (cmake/licenses.cmake):
#
#   cmake -DOUT=<Notices.cpp> -DFILES=<path;...> -DNAMES=<name;...> -P <this file>
#
# Each file becomes a char array initialized from adjacent string literals, so its bytes are
# embedded exactly, NULs included (the length is the array's, not strlen's), with no new
# dependency (no CMakeRC, no JUCE BinaryData):
# - printable ASCII is written as itself, except `"` and `\`, which are escaped;
# - every other byte (a newline, a tab, UTF-8) is a \xHH escape. A hex escape is greedy, so when
#   the next character is a hex digit the literal is closed and a new one opened;
# - each line of the text ends its literal, so the generated file reads line for line like the
#   text;
# - and the file is cut into pieces of at most 16,000 bytes, each its own run of literals, so no
#   literal comes near MSVC's 16,380-byte limit on one string literal.

cmake_minimum_required(VERSION 3.22)

foreach (var IN ITEMS OUT FILES NAMES)
    if (NOT DEFINED ${var})
        message(FATAL_ERROR "embed-text: ${var} is not set")
    endif ()
endforeach ()

# Bytes per piece; each piece's literals together hold at most this many.
set(gg_piece_bytes 16000)

# A marker no output contains: the byte 0x01 is not printable, so in the output it is always the
# escape text \x01, never the byte itself. Each input byte becomes <marker><two hex digits>, and
# replacing those tokens can't match across what an earlier replacement wrote.
string(ASCII 1 gg_mark)

# gg_escape(<out> <hex>): the C++ literal text (without the outer quotes) of the bytes <hex>
# spells, two lowercase hex digits per byte, as file(READ ... HEX) gives them.
function(gg_escape out hex)
    string(REGEX REPLACE "(..)" "${gg_mark}\\1" text "${hex}")
    # Printable ASCII, 0x20 to 0x7e, as itself.
    foreach (code RANGE 32 126)
        string(ASCII ${code} char)
        if (char STREQUAL "\"")
            set(char "\\\"")
        elseif (char STREQUAL "\\")
            set(char "\\\\")
        endif ()
        math(EXPR hi "${code} / 16")
        math(EXPR lo "${code} % 16")
        string(SUBSTRING "0123456789abcdef" ${hi} 1 hi)
        string(SUBSTRING "0123456789abcdef" ${lo} 1 lo)
        string(REPLACE "${gg_mark}${hi}${lo}" "${char}" text "${text}")
    endforeach ()
    # Everything left is outside printable ASCII. A newline also ends the line's literal.
    string(REPLACE "${gg_mark}0a" "\\x0a\"\n    \"" text "${text}")
    string(REGEX REPLACE "${gg_mark}(..)" "\\\\x\\1" text "${text}")
    # A hex escape followed by a hex digit would swallow it: split the literal there.
    string(REGEX REPLACE "(\\\\x[0-9a-f][0-9a-f])([0-9A-Fa-f])" "\\1\" \"\\2" text "${text}")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

list(LENGTH FILES file_count)
list(LENGTH NAMES name_count)
if (NOT file_count EQUAL name_count OR file_count EQUAL 0)
    message(FATAL_ERROR "embed-text: ${file_count} files but ${name_count} names")
endif ()

set(arrays "")
set(entries "")
set(index 0)
foreach (source name IN ZIP_LISTS FILES NAMES)
    if (NOT EXISTS "${source}")
        message(FATAL_ERROR "embed-text: '${source}' (${name}) doesn't exist")
    endif ()
    file(READ "${source}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR piece_hex "${gg_piece_bytes} * 2")

    string(APPEND arrays "// ${name}\nconstexpr char kText${index}[] =\n")
    if (hex_length EQUAL 0)
        string(APPEND arrays "    \"\"\n")
    endif ()
    set(offset 0)
    while (offset LESS hex_length)
        string(SUBSTRING "${hex}" ${offset} ${piece_hex} piece)
        gg_escape(literal "${piece}")
        # A piece that ends with a newline would leave an empty literal behind it.
        string(REGEX REPLACE "\n    \"\"$" "" literal "\"${literal}\"")
        string(APPEND arrays "    ${literal}\n")
        math(EXPR offset "${offset} + ${piece_hex}")
    endwhile ()
    string(REGEX REPLACE "\n$" ";\n\n" arrays "${arrays}")

    string(HEX "${name}" name_hex)
    gg_escape(name_literal "${name_hex}")
    string(HEX "${source}" source_hex)
    gg_escape(source_literal "${source_hex}")
    string(APPEND entries "    NoticeText{\"${name_literal}\", \"${source_literal}\", "
            "std::string_view(kText${index}, sizeof(kText${index}) - 1)},\n")
    math(EXPR index "${index} + 1")
endforeach ()

set(content "// Generated by cmake/embed-text.cmake from the license set (cmake/licenses.cmake).
// Don't edit: it is rewritten whenever a license text changes.

#include \"gg/ui/Notices.h\"

#include <array>
#include <string_view>

namespace gg::ui
{
namespace
{
${arrays}constexpr std::array<NoticeText, ${index}> kNotices{
${entries}};
} // namespace

std::span<const NoticeText> noticeTexts() noexcept { return kNotices; }
} // namespace gg::ui
")

file(WRITE "${OUT}" "${content}")
