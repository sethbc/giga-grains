<?xml version="1.0" encoding="UTF-8"?>
<!--
  Giga Grains — granular instrument and effect
  SPDX-License-Identifier: AGPL-3.0-or-later
  Copyright 2026, the Giga Grains authors (see git history)

  The two standalone apps' entitlements, signed in with a real identity
  (clients/clap-first/CMakeLists.txt; spec §6.2). Under the hardened runtime an app reads no
  audio input without com.apple.security.device.audio-input: the FX standalone records live
  input. Its Info.plist's NSMicrophoneUsageDescription is the text macOS shows when it asks.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
